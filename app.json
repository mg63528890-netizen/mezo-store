{
  "expo": {
    "name": "Mezo",
    "slug": "mezo-store",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mezo",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.mezostore.admin",
      "infoPlist": {
        "CFBundleDisplayName": "Mezo",
        "CFBundleAllowMixedLocalizations": true,
        "NSFaceIDUsageDescription": "يستخدم لتأمين الدخول إلى حساب إدارة ميزو ستور",
        "NSLocalNetworkUsageDescription": "يستخدم للاتصال بطابعة الفواتير عبر شبكة Wi-Fi المحلية"
      }
    },
    "android": {
      "package": "com.mezostore.admin",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "permissions": [
        "USE_BIOMETRIC",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "POST_NOTIFICATIONS"
      ],
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Tajawal-Regular.ttf",
            "./assets/fonts/Tajawal-Medium.ttf",
            "./assets/fonts/Tajawal-Bold.ttf",
            "./assets/fonts/Inter.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/icon.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      "expo-local-authentication",
      "expo-sharing",
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#A9833F"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "supportsRTL": true
    }
  }
}
